{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [
    ],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "src"
  ]
}
